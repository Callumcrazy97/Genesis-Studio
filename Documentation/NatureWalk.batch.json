    {"input":{"recipes":["FirstPerson"],"name":"Walker","events":{"Step":"// The path is the terrain\u0027s second paint layer (Dirt).\nif (Engine.Terrain.MaterialAt(x, z) == 2) { stepSound = \"Step Path\"; } else { stepSound = \"Step Grass\"; }","Create":"stepSound = \"Step Grass\";\n// The look: shade a little lighter, as the sky lights it in the three.js version.\nEngine.Rendering.Shadows.Strength = 0.7;\n// Start with the feet on the ground, wherever the path is.\ny = Engine.Terrain.GetHeight(x, z);\nCharacterSetPosition(x, y, z);\n// A second in, the game checks itself (game.run reports these).\nSetAlarm(1, 60);","Alarm1":"TestCheck(\"the walker stands on the ground\", Abs(y - Engine.Terrain.GetHeight(x, z)) \u003c 0.3, \"feet \" + String(y) + \", ground \" + String(Engine.Terrain.GetHeight(x, z)));\nTestCheck(\"the walk starts on the path\", Engine.Terrain.MaterialAt(x, z) == 2, \"layer \" + String(Engine.Terrain.MaterialAt(x, z)));"}},"command":"object.create"},
