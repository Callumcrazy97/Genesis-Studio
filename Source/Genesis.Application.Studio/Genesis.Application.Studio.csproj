<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Genesis.Application.Core\Genesis.Application.Core.csproj" />
    <ProjectReference Include="..\Genesis.Application.Editors.Image\Genesis.Application.Editors.Image.csproj" />
    <ProjectReference Include="..\Genesis.Application.Editors.Suite\Genesis.Application.Editors.Suite.csproj" />
    <ProjectReference Include="..\Runtime\Genesis.Rendering\Genesis.Rendering.csproj" />
    <ProjectReference Include="..\Runtime\Genesis.Shared\Genesis.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Branding, and the theme images that ship as defaults. The Themes glob is linked from the
         repository root so the folder a designer drops images into is the same one that ships. -->
    <!-- ApplicationIcon stamps the executable but does not copy the file, and windows read their
         icon from it at run time so that a window and its taskbar button always match. -->
    <Content Include="Assets\Genesis.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Genesis_Studio_Logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Genesis_Studio_Emblem.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\CommandVisualTest\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Themes\*.jpg" Link="Themes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DockPanelSuite" Version="3.1.1" />
    <PackageReference Include="DockPanelSuite.ThemeVS2015" Version="3.1.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Genesis.Application.Studio</RootNamespace>
    <AssemblyName>Genesis Application</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\Genesis.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- This revision is source-owned; the run identity comes from Build.bat. It is embedded
         in the loaded assembly so an old executable cannot borrow a new sidecar's identity. -->
    <GenesisStudioRevision>22</GenesisStudioRevision>
    <GenesisBuildId Condition="'$(GenesisBuildId)' == ''">local</GenesisBuildId>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Genesis.StudioRevision" Value="$(GenesisStudioRevision)" />
    <AssemblyMetadata Include="Genesis.BuildId" Value="$(GenesisBuildId)" />
    <AssemblyMetadata Include="Genesis.BuildConfiguration" Value="$(Configuration)" />
  </ItemGroup>

</Project>
