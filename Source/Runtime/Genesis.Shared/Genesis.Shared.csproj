<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.150.1" GeneratePathProperty="true" />
    <PackageReference Include="StbImageSharp" Version="2.27.14" />
  </ItemGroup>

  <!-- Genesis's own licence and the notices every copy must carry. Studio, the Player and each
       exported game reference this project, so its Licenses folder reaches all three. Build.bat adds the .NET runtime's
       own licence files to a published package. -->
  <ItemGroup>
    <None Include="..\..\..\LICENSE.md" Link="Licenses\Genesis-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\Documentation\ThirdPartyNotices.txt" Link="Licenses\ThirdPartyNotices.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgSkiaSharp_NativeAssets_Win32)\THIRD-PARTY-NOTICES.txt" Link="Licenses\SkiaSharp-THIRD-PARTY-NOTICES.txt"
          Condition="Exists('$(PkgSkiaSharp_NativeAssets_Win32)\THIRD-PARTY-NOTICES.txt')"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
