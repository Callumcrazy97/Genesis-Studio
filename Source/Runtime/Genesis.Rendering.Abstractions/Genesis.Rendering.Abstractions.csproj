<Project Sdk="Microsoft.NET.Sdk">

  <!-- The GPU abstraction every backend implements.

       net10.0, not net10.0-windows: nothing here may touch a Windows-only API, which is what keeps
       a future non-Windows backend possible.

       Deliberately ZERO package references. This assembly is the seam between the renderer and the
       native graphics stacks, so it must not carry one; Silk.NET.Direct3D11, Silk.NET.Vulkan and
       Silk.NET.OpenGL each belong to exactly one backend assembly below it.

       It is also NOT part of Genesis.Shared: the whole ~13,000-line Application layer references
       Genesis.Shared, and putting GpuPipelineKey/IGpuSwapChain there would make every editor
       assembly transitively see them — precisely the leak Genesis.Shared's zero-graphics policy
       exists to prevent. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Genesis.Shared\Genesis.Shared.csproj" />
  </ItemGroup>

</Project>
