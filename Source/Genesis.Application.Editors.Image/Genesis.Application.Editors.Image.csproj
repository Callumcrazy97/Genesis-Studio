<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Genesis.Application.Editors.Image</RootNamespace>
    <AssemblyName>Genesis.Application.Editors.Image</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Genesis.Application.Core\Genesis.Application.Core.csproj" />
    <ProjectReference Include="..\Runtime\Genesis.Shared\Genesis.Shared.csproj" />
    <ProjectReference Include="..\Runtime\Genesis.Runtime\Genesis.Runtime.csproj" />
    <ProjectReference Include="..\Runtime\Genesis.Rendering\Genesis.Rendering.csproj" />
    <ProjectReference Include="..\Runtime\Genesis.Rendering.WinForms\Genesis.Rendering.WinForms.csproj" />
  </ItemGroup>

</Project>
