<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Genesis.Application.Editors.Suite</RootNamespace>
    <AssemblyName>Genesis.Application.Editors.Suite</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- WFO1000: designer serialization hints — the suite never uses the WinForms designer. -->
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Genesis.Application.Core\Genesis.Application.Core.csproj" />
    <ProjectReference Include="..\Genesis.Application.Editors.Image\Genesis.Application.Editors.Image.csproj" />
    <ProjectReference Include="..\Runtime\Genesis.Shared\Genesis.Shared.csproj" />
    <ProjectReference Include="..\Runtime\Genesis.Runtime\Genesis.Runtime.csproj" />
    <ProjectReference Include="..\Runtime\Genesis.Rendering\Genesis.Rendering.csproj" />
    <ProjectReference Include="..\Runtime\Genesis.Rendering.WinForms\Genesis.Rendering.WinForms.csproj" />
    <ProjectReference Include="..\Runtime\Genesis.World\Genesis.World.csproj" />
    <ProjectReference Include="..\Runtime\Genesis.Audio\Genesis.Audio.csproj" />
    <ProjectReference Include="..\Runtime\Genesis.Physics\Genesis.Physics.csproj" />
  </ItemGroup>

</Project>
