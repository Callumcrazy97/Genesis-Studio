<Window x:Class="DevProfiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DevProfiler.Controls"
        Title="DevProfiler v1.0.2 // Python + .NET 10"
        Width="1500" Height="950" MinWidth="1120" MinHeight="720">
    <Grid Background="{StaticResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⬡ DevProfiler" FontSize="21" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                    <TextBlock Text="  Python cProfile · .NET EventPipe · Process Tree · CPU · RAM · FPS" Margin="12,6,0,0" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CaptureQualityText" Text="Select a target" Foreground="{StaticResource MutedBrush}" Margin="0,0,20,0"/>
                    <TextBlock x:Name="StatusText" Text="● IDLE" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource BgPanelBrush}" Padding="10,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Language" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox x:Name="LanguageCombo" Grid.Column="1" SelectionChanged="LanguageCombo_SelectionChanged">
                    <ComboBoxItem Content="Python" IsSelected="True"/>
                    <ComboBoxItem Content=".NET 10"/>
                    <ComboBoxItem Content="PowerShell"/>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="Target" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="TargetPathBox" Grid.Column="3" TextChanged="TargetPathBox_TextChanged"/>
                <Button Grid.Column="4" Content="Browse" Click="BrowseTarget_Click"/>
                <TextBox x:Name="ArgumentsBox" Grid.Column="5" ToolTip="Command-line arguments" Margin="5,0"/>
                <Button x:Name="RunButton" Grid.Column="6" Content="▶ RUN" Foreground="{StaticResource GreenBrush}" BorderBrush="{StaticResource GreenBrush}" FontWeight="Bold" Click="RunButton_Click"/>

                <TextBlock Grid.Row="1" Text="Runtime" VerticalAlignment="Center" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="RuntimePathBox" Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" ToolTip="Optional. Python interpreter or dotnet.exe."/>
                <Button Grid.Row="1" Grid.Column="2" Content="Browse" Click="BrowseRuntime_Click" Margin="4,7,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Working directory" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,7,0,0" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="WorkingDirectoryBox" Grid.Row="1" Grid.Column="3" Margin="145,7,0,0"/>
                <Button Grid.Row="1" Grid.Column="4" Content="Browse" Click="BrowseWorkingDirectory_Click" Margin="3,7,0,0"/>
                <Button Grid.Row="1" Grid.Column="5" Content="Export Markdown" HorizontalAlignment="Left" Click="Export_Click" Margin="5,7,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="10,8,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{x:Null}" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" Background="{StaticResource BgCardBrush}" Padding="12,7" Margin="3"><StackPanel><TextBlock Text="TARGET CPU" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="CpuMetric" Text="0.0%" Foreground="{StaticResource CyanBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
            <Border Grid.Column="1" BorderBrush="{StaticResource PurpleBrush}" BorderThickness="1" Background="{StaticResource BgCardBrush}" Padding="12,7" Margin="3"><StackPanel><TextBlock Text="PRIVATE RAM" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="RamMetric" Text="0 MB" Foreground="{StaticResource PurpleBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
            <Border Grid.Column="2" BorderBrush="{StaticResource GreenBrush}" BorderThickness="1" Background="{StaticResource BgCardBrush}" Padding="12,7" Margin="3"><StackPanel><TextBlock Text="FPS" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="FpsMetric" Text="—" Foreground="{StaticResource GreenBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
            <Border Grid.Column="3" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="1" Background="{StaticResource BgCardBrush}" Padding="12,7" Margin="3"><StackPanel><TextBlock Text="TIME" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="TimeMetric" Text="0.0s" Foreground="{StaticResource OrangeBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
            <Border Grid.Column="4" BorderBrush="{StaticResource RedBrush}" BorderThickness="1" Background="{StaticResource BgCardBrush}" Padding="12,7" Margin="3"><StackPanel><TextBlock Text="FUNCTIONS" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="FunctionsMetric" Text="—" Foreground="{StaticResource RedBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
            <Border Grid.Column="5" BorderBrush="{StaticResource YellowBrush}" BorderThickness="1" Background="{StaticResource BgCardBrush}" Padding="12,7" Margin="3"><StackPanel><TextBlock Text="PROCESSES" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="ProcessesMetric" Text="0" Foreground="{StaticResource YellowBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
        </Grid>

        <TabControl Grid.Row="3" Margin="10,4,10,8">
            <TabItem Header="📊 Merged Table">
                <Grid Background="{StaticResource BgCardBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="8">
                        <TextBlock Text="Filter" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="FunctionFilterBox" Width="320" Margin="8,0" TextChanged="FunctionFilterBox_TextChanged"/>
                        <TextBlock x:Name="ResultCountText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <DataGrid x:Name="MergedGrid" Grid.Row="1" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="45"/>
                            <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="130"/>
                            <DataGridTextColumn Header="Calls / Samples" Binding="{Binding CallsDisplay}" Width="115"/>
                            <DataGridTextColumn Header="Self ms" Binding="{Binding SelfMs, StringFormat=N3}" Width="90"/>
                            <DataGridTextColumn Header="Inclusive ms" Binding="{Binding InclusiveMs, StringFormat=N3}" Width="105"/>
                            <DataGridTextColumn Header="Per Call ms" Binding="{Binding PerCallMs, StringFormat=N6}" Width="100"/>
                            <DataGridTextColumn Header="File / Module" Binding="{Binding File}" Width="180"/>
                            <DataGridTextColumn Header="Function / Method" Binding="{Binding Function}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="115"/>
                            <DataGridTextColumn Header="Accuracy" Binding="{Binding Accuracy}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="🔀 Per-Process">
                <Grid Background="{StaticResource BgCardBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DataGrid x:Name="ProcessGrid" Margin="8" SelectionChanged="ProcessGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65"/>
                            <DataGridTextColumn Header="PPID" Binding="{Binding ParentProcessId}" Width="65"/>
                            <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="CPU" Binding="{Binding CpuPercent, StringFormat=N1}" Width="65"/>
                            <DataGridTextColumn Header="Private MB" Binding="{Binding PrivateMemoryMb, StringFormat=N1}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>
                    <DataGrid x:Name="ProcessFunctionGrid" Grid.Column="2" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Calls / Samples" Binding="{Binding CallsDisplay}" Width="115"/>
                            <DataGridTextColumn Header="Self ms" Binding="{Binding SelfMs, StringFormat=N3}" Width="90"/>
                            <DataGridTextColumn Header="Inclusive ms" Binding="{Binding InclusiveMs, StringFormat=N3}" Width="105"/>
                            <DataGridTextColumn Header="File" Binding="{Binding File}" Width="170"/>
                            <DataGridTextColumn Header="Function" Binding="{Binding Function}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="📈 Graphs">
                <Grid Background="{StaticResource BgCardBrush}" Margin="8">
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <controls:LineGraph x:Name="CpuGraph" Margin="4"/>
                    <controls:LineGraph x:Name="RamGraph" Grid.Column="1" Margin="4"/>
                    <controls:LineGraph x:Name="FpsGraph" Grid.Column="2" Margin="4"/>
                    <controls:LineGraph x:Name="ThreadsGraph" Grid.Row="1" Margin="4"/>
                    <controls:LineGraph x:Name="ReadGraph" Grid.Row="1" Grid.Column="1" Margin="4"/>
                    <controls:LineGraph x:Name="WriteGraph" Grid.Row="1" Grid.Column="2" Margin="4"/>
                </Grid>
            </TabItem>

            <TabItem Header="⚠ Warnings">
                <DataGrid x:Name="WarningsGrid" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Severity" Binding="{Binding SeverityDisplay}" Width="100"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="260"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Body}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="🗒 Event Log">
                <DataGrid x:Name="EventGrid" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="105"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessDisplay}" Width="65"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="210"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="📄 Raw Output (live)">
                <TextBox x:Name="RawOutputBox" Margin="8" FontSize="12" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterText" Text="Ready. Python results are exact; .NET method timings are sampled estimates." Margin="10,5" Foreground="{StaticResource MutedBrush}"/>
        </Border>
    </Grid>
</Window>
