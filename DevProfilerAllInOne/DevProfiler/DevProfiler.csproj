<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DevProfiler</AssemblyName>
    <RootNamespace>DevProfiler</RootNamespace>
    <Version>1.1.2</Version>
    <Authors>Cal / OpenAI</Authors>
    <Description>All-in-one Python, .NET and PowerShell application profiler.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\sitecustomize.py" />
    <EmbeddedResource Include="Resources\devprofiler_bootstrap.py" />
    <EmbeddedResource Include="Resources\devprofiler_powershell_bootstrap.ps1" />
  </ItemGroup>
</Project>
