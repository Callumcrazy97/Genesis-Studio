// VM speed benchmark: the chunk mesher of a voxel test project (McMesh.pgsl: McBuildRow, McBuildColumn,
// McCubeFaces, McFaceLit, McLA), copied unchanged, meshing the inner 14 x 14 columns of McLightBench's
// chunk after its light has been spread: the ground's top faces and every wall of the cave, each face
// smooth-lit from the nine cells around it. Run McLightBench first; it makes the world and the light.

// ---- helpers the copied functions call (simplified stand-ins for the project's McWorld / McData) ----
function McColH(bx, bz) { return DsGridGet(hgt, bx & 255, bz & 255); }

// ---- copied from McMesh.pgsl ----
function McLA(sky, blk) { return (Floor(sky * 4 + 0.5) * 64 + Floor(blk * 4 + 0.5)) / 4096; }

function McFaceLit(m, bit, bx, by, bz, size, tile, r, g, b) {
    var nx = 0; var ny = 0; var nz = 0; var rx = 0; var ry = 0; var rz = 0; var ux = 0; var uy = 0; var uz = 0;
    if (bit == 4) { ny = 1; uz = 1; rx = 1; }
    else if (bit == 8) { ny = -1; uz = -1; rx = 1; }
    else if (bit == 1) { nx = 1; uy = 1; rz = 1; }
    else if (bit == 2) { nx = -1; uy = 1; rz = -1; }
    else if (bit == 16) { nz = 1; uy = 1; rx = -1; }
    else { nz = -1; uy = 1; rx = 1; }
    var cx = bx + nx; var cy = by + ny; var cz = bz + nz;
    var a0 = 0; var a1 = 0; var a2 = 0; var a3 = 0; var o0 = 1; var o1 = 1; var o2 = 1; var o3 = 1;
    if (smoothLight == 1) {
        var x0 = cx - rx - ux; var y0 = cy - ry - uy; var z0 = cz - rz - uz; var s0 = 15; var b0 = 0; var p0 = 0;
        if (y0 >= 0 && y0 < 96) { var g0 = (z0 >> 4) & 15; var c0 = (x0 & 255) + ((z0 & 15) << 8); var w0 = DsGridGet(auxBase + g0, c0, y0); s0 = w0 % 16; b0 = Floor(w0 / 16) % 16; p0 = DsListGet(ltOp, DsGridGet(wgBase + g0, c0, y0)); }
        var x1 = cx - ux; var y1 = cy - uy; var z1 = cz - uz; var s1 = 15; var b1 = 0; var p1 = 0;
        if (y1 >= 0 && y1 < 96) { var g1 = (z1 >> 4) & 15; var c1 = (x1 & 255) + ((z1 & 15) << 8); var w1 = DsGridGet(auxBase + g1, c1, y1); s1 = w1 % 16; b1 = Floor(w1 / 16) % 16; p1 = DsListGet(ltOp, DsGridGet(wgBase + g1, c1, y1)); }
        var x2 = cx + rx - ux; var y2 = cy + ry - uy; var z2 = cz + rz - uz; var s2 = 15; var b2 = 0; var p2 = 0;
        if (y2 >= 0 && y2 < 96) { var g2 = (z2 >> 4) & 15; var c2 = (x2 & 255) + ((z2 & 15) << 8); var w2 = DsGridGet(auxBase + g2, c2, y2); s2 = w2 % 16; b2 = Floor(w2 / 16) % 16; p2 = DsListGet(ltOp, DsGridGet(wgBase + g2, c2, y2)); }
        var x3 = cx - rx; var y3 = cy - ry; var z3 = cz - rz; var s3 = 15; var b3 = 0; var p3 = 0;
        if (y3 >= 0 && y3 < 96) { var g3 = (z3 >> 4) & 15; var c3 = (x3 & 255) + ((z3 & 15) << 8); var w3 = DsGridGet(auxBase + g3, c3, y3); s3 = w3 % 16; b3 = Floor(w3 / 16) % 16; p3 = DsListGet(ltOp, DsGridGet(wgBase + g3, c3, y3)); }
        var x4 = cx; var y4 = cy; var z4 = cz; var s4 = 15; var b4 = 0; var p4 = 0;
        if (y4 >= 0 && y4 < 96) { var g4 = (z4 >> 4) & 15; var c4 = (x4 & 255) + ((z4 & 15) << 8); var w4 = DsGridGet(auxBase + g4, c4, y4); s4 = w4 % 16; b4 = Floor(w4 / 16) % 16; p4 = DsListGet(ltOp, DsGridGet(wgBase + g4, c4, y4)); }
        var x5 = cx + rx; var y5 = cy + ry; var z5 = cz + rz; var s5 = 15; var b5 = 0; var p5 = 0;
        if (y5 >= 0 && y5 < 96) { var g5 = (z5 >> 4) & 15; var c5 = (x5 & 255) + ((z5 & 15) << 8); var w5 = DsGridGet(auxBase + g5, c5, y5); s5 = w5 % 16; b5 = Floor(w5 / 16) % 16; p5 = DsListGet(ltOp, DsGridGet(wgBase + g5, c5, y5)); }
        var x6 = cx - rx + ux; var y6 = cy - ry + uy; var z6 = cz - rz + uz; var s6 = 15; var b6 = 0; var p6 = 0;
        if (y6 >= 0 && y6 < 96) { var g6 = (z6 >> 4) & 15; var c6 = (x6 & 255) + ((z6 & 15) << 8); var w6 = DsGridGet(auxBase + g6, c6, y6); s6 = w6 % 16; b6 = Floor(w6 / 16) % 16; p6 = DsListGet(ltOp, DsGridGet(wgBase + g6, c6, y6)); }
        var x7 = cx + ux; var y7 = cy + uy; var z7 = cz + uz; var s7 = 15; var b7 = 0; var p7 = 0;
        if (y7 >= 0 && y7 < 96) { var g7 = (z7 >> 4) & 15; var c7 = (x7 & 255) + ((z7 & 15) << 8); var w7 = DsGridGet(auxBase + g7, c7, y7); s7 = w7 % 16; b7 = Floor(w7 / 16) % 16; p7 = DsListGet(ltOp, DsGridGet(wgBase + g7, c7, y7)); }
        var x8 = cx + rx + ux; var y8 = cy + ry + uy; var z8 = cz + rz + uz; var s8 = 15; var b8 = 0; var p8 = 0;
        if (y8 >= 0 && y8 < 96) { var g8 = (z8 >> 4) & 15; var c8 = (x8 & 255) + ((z8 & 15) << 8); var w8 = DsGridGet(auxBase + g8, c8, y8); s8 = w8 % 16; b8 = Floor(w8 / 16) % 16; p8 = DsListGet(ltOp, DsGridGet(wgBase + g8, c8, y8)); }
        var k0 = s4; var h0 = b4; var n0 = 1; var q0 = 0;
        if (p3 >= 15) { q0 = q0 + 1; } else { k0 = k0 + s3; h0 = h0 + b3; n0 = n0 + 1; }
        if (p7 >= 15) { q0 = q0 + 1; } else { k0 = k0 + s7; h0 = h0 + b7; n0 = n0 + 1; }
        if (q0 < 2) { if (p6 >= 15) { q0 = q0 + 1; } else { k0 = k0 + s6; h0 = h0 + b6; n0 = n0 + 1; } }
        a0 = (Floor(k0 * 4 / n0 + 0.5) * 64 + Floor(h0 * 4 / n0 + 0.5)) / 4096; o0 = 1 - q0 * 0.2;
        var k1 = s4; var h1 = b4; var n1 = 1; var q1 = 0;
        if (p5 >= 15) { q1 = q1 + 1; } else { k1 = k1 + s5; h1 = h1 + b5; n1 = n1 + 1; }
        if (p7 >= 15) { q1 = q1 + 1; } else { k1 = k1 + s7; h1 = h1 + b7; n1 = n1 + 1; }
        if (q1 < 2) { if (p8 >= 15) { q1 = q1 + 1; } else { k1 = k1 + s8; h1 = h1 + b8; n1 = n1 + 1; } }
        a1 = (Floor(k1 * 4 / n1 + 0.5) * 64 + Floor(h1 * 4 / n1 + 0.5)) / 4096; o1 = 1 - q1 * 0.2;
        var k2 = s4; var h2 = b4; var n2 = 1; var q2 = 0;
        if (p5 >= 15) { q2 = q2 + 1; } else { k2 = k2 + s5; h2 = h2 + b5; n2 = n2 + 1; }
        if (p1 >= 15) { q2 = q2 + 1; } else { k2 = k2 + s1; h2 = h2 + b1; n2 = n2 + 1; }
        if (q2 < 2) { if (p2 >= 15) { q2 = q2 + 1; } else { k2 = k2 + s2; h2 = h2 + b2; n2 = n2 + 1; } }
        a2 = (Floor(k2 * 4 / n2 + 0.5) * 64 + Floor(h2 * 4 / n2 + 0.5)) / 4096; o2 = 1 - q2 * 0.2;
        var k3 = s4; var h3 = b4; var n3 = 1; var q3 = 0;
        if (p3 >= 15) { q3 = q3 + 1; } else { k3 = k3 + s3; h3 = h3 + b3; n3 = n3 + 1; }
        if (p1 >= 15) { q3 = q3 + 1; } else { k3 = k3 + s1; h3 = h3 + b1; n3 = n3 + 1; }
        if (q3 < 2) { if (p0 >= 15) { q3 = q3 + 1; } else { k3 = k3 + s0; h3 = h3 + b0; n3 = n3 + 1; } }
        a3 = (Floor(k3 * 4 / n3 + 0.5) * 64 + Floor(h3 * 4 / n3 + 0.5)) / 4096; o3 = 1 - q3 * 0.2;
    } else {
        var af = 15; if (cy >= 0 && cy < 96) { af = DsGridGet(auxBase + ((cz >> 4) & 15), (cx & 255) + ((cz & 15) << 8), cy); }
        a0 = ((af % 16) * 256 + (Floor(af / 16) % 16) * 4) / 4096; a1 = a0; a2 = a0; a3 = a0;
    }
    // corners in the same layout and texture orientation as MeshAddCube
    var h = size * 0.5;
    var fx = bx + 0.5 + nx * h; var fy = by + 0.5 + ny * h; var fz = bz + 0.5 + nz * h;
    var u0 = (tile & 31) / 32 + 0.0002; var v0 = Floor(tile / 32) / atlasRows + 0.0002;
    var u1 = u0 + tileDU; var v1 = v0 + tileDV;
    var i0 = MeshAddVertex(m, fx + (0 - rx + ux) * h, fy + (0 - ry + uy) * h, fz + (0 - rz + uz) * h, nx, ny, nz, u0, v0, r * o0, g * o0, b * o0, a0);
    var i1 = MeshAddVertex(m, fx + (rx + ux) * h, fy + (ry + uy) * h, fz + (rz + uz) * h, nx, ny, nz, u1, v0, r * o1, g * o1, b * o1, a1);
    var i2 = MeshAddVertex(m, fx + (rx - ux) * h, fy + (ry - uy) * h, fz + (rz - uz) * h, nx, ny, nz, u1, v1, r * o2, g * o2, b * o2, a2);
    var i3 = MeshAddVertex(m, fx + (0 - rx - ux) * h, fy + (0 - ry - uy) * h, fz + (0 - rz - uz) * h, nx, ny, nz, u0, v1, r * o3, g * o3, b * o3, a3);
    if (o0 + o2 + a0 + a2 >= o1 + o3 + a1 + a3) { MeshAddTriangle(m, i0, i1, i2); MeshAddTriangle(m, i0, i2, i3); }
    else { MeshAddTriangle(m, i1, i2, i3); MeshAddTriangle(m, i1, i3, i0); }
}

function McCubeFaces(m, k, wx, cy, wz, mask, r, gcol, b, tint) {
    var tf = DsListGet(bkTF, k); var face = -1;
    if (tf >= 0) {
        var fk = StringOf(wx) + "," + StringOf(cy) + "," + StringOf(wz);
        face = 0; if (DsMapExists(facingMap, fk)) { face = DsMapGet(facingMap, fk); }
    }
    var sr = r; var sg = gcol; var sb = b;      // side / bottom colour: grass keeps its dirt sides untinted
    if (tint == 1) { sr = 255; sg = 255; sb = 255; }
    if ((mask & 4) != 0) { McFaceLit(m, 4, wx, cy, wz, 1, DsListGet(bkTT, k), r, gcol, b); }
    if ((mask & 8) != 0) { McFaceLit(m, 8, wx, cy, wz, 1, DsListGet(bkTB, k), sr, sg, sb); }
    var tile = DsListGet(bkTS, k); var ov = DsListGet(bkTO, k);
    for (var bit = 1; bit <= 32; bit = bit * 2) {
        if (bit != 4 && bit != 8 && (mask & bit) != 0) {
            var ft = tile;
            if (tf >= 0) {
                if ((face == 0 && bit == 16) || (face == 1 && bit == 2) || (face == 2 && bit == 32) || (face == 3 && bit == 1)) { ft = tf; }
            }
            McFaceLit(m, bit, wx, cy, wz, 1, ft, sr, sg, sb);
            if (tint == 1 && ov >= 0) { McFaceLit(m, bit, wx, cy, wz, 1.004, ov, r, gcol, b); }
        }
    }
}

function McBuildColumn(cx, cz, s, lz, lx, m, il) {
    var wz = cz * 16 + lz; var wx = cx * 16 + lx;
    var g = wgBase + (cz & 15);
    var gm = wgBase + (((wz - 1) >> 4) & 15); var gp = wgBase + (((wz + 1) >> 4) & 15);
    var oc = lz << 8; var om = ((wz - 1) & 15) << 8; var op = ((wz + 1) & 15) << 8;
    var top = McColH(wx, wz);
    var mn = McColH(wx - 1, wz); var t2 = McColH(wx + 1, wz); if (t2 < mn) { mn = t2; }
    t2 = McColH(wx, wz - 1); if (t2 < mn) { mn = t2; }
    t2 = McColH(wx, wz + 1); if (t2 < mn) { mn = t2; }
    var lo = top; if (mn < top) { lo = mn + 1; }
    var hi = top;
    var col = lz * 16 + lx;
    var eLo = DsGridGet(extLoG, col, s); var eHi = DsGridGet(extHiG, col, s);
    if (eHi >= eLo) { if (eLo < lo) { lo = eLo; } if (eHi > hi) { hi = eHi; } }
    var clo = DsGridGet(cavLoG, col, s); var chi = DsGridGet(cavHiG, col, s);
    if (chi >= clo && clo <= hi + 1 && chi >= lo - 1) { if (clo < lo) { lo = clo; } if (chi > hi) { hi = chi; } clo = 1; chi = 0; }
    if (lo < 0) { lo = 0; }
    if (hi > 95) { hi = 95; }
    if (clo < 0) { clo = 0; }
    if (chi > 95) { chi = 95; }
    var cc = wx & 255;
    var ci = cc + oc; var cE = ((wx + 1) & 255) + oc; var cW = ((wx - 1) & 255) + oc;
    var cN = cc + op; var cS = cc + om;
    var bi = DsGridGet(bio, cc, wz & 255);
    var px = wx + 0.5; var pz = wz + 0.5;
    for (var pass = 0; pass < 2; pass = pass + 1) {
        var y0 = lo; var y1 = hi;
        if (pass == 1) { y0 = clo; y1 = chi; }
        for (var cy = y0; cy <= y1; cy = cy + 1) {
            var k = DsGridGet(g, ci, cy);
            if (k > 0) {
                var fl = DsListGet(bkFlags, k);
                if ((fl & 4) == 0) {
                    var shp = DsListGet(bkShape, k);
                    var mask = 63;
                    if ((fl & 8) == 0 && shp == 0) {
                        var nE = DsGridGet(g, cE, cy); var nW = DsGridGet(g, cW, cy);
                        var nN = DsGridGet(gp, cN, cy); var nS = DsGridGet(gm, cS, cy);
                        var nU = 0; if (cy < 95) { nU = DsGridGet(g, ci, cy + 1); }
                        var nD = 8; if (cy > 0) { nD = DsGridGet(g, ci, cy - 1); }
                        mask = 0;
                        if (nE == 0 || (nE != k && (DsListGet(bkFlags, nE) & 2) == 0)) { mask = mask + 1; }
                        if (nW == 0 || (nW != k && (DsListGet(bkFlags, nW) & 2) == 0)) { mask = mask + 2; }
                        if (nU == 0 || (nU != k && (DsListGet(bkFlags, nU) & 2) == 0)) { mask = mask + 4; }
                        if (nD == 0 || (nD != k && (DsListGet(bkFlags, nD) & 2) == 0)) { mask = mask + 8; }
                        if (nN == 0 || (nN != k && (DsListGet(bkFlags, nN) & 2) == 0)) { mask = mask + 16; }
                        if (nS == 0 || (nS != k && (DsListGet(bkFlags, nS) & 2) == 0)) { mask = mask + 32; }
                    }
                    if (mask > 0) {
                        var tint = DsListGet(bkTint, k);
                        var r = 255; var gcol = 255; var b = 255;
                        if (tint > 0) { var ti = tint * 8 + bi; r = DsListGet(tintR, ti); gcol = DsListGet(tintG, ti); b = DsListGet(tintB, ti); }
                        if (DsListGet(bkLight, k) > 0) { McEmitInst(il, wx, cy, wz, k, bi); }
                        else if ((fl & 8) != 0) { McAddCross(m, px, cy + 0.5, pz, DsListGet(bkTT, k), r, gcol, b, McLA(McSkyAt(wx, cy, wz), McBlkAt(wx, cy, wz))); }
                        else if (shp > 0) { McMeshShape(m, k, wx, cy, wz, r, gcol, b); }
                        else { McCubeFaces(m, k, wx, cy, wz, mask, r, gcol, b, tint); }
                    }
                }
            }
        }
    }
}

// ---- the benchmark's own data (script top level): one block kind, stone, an opaque full cube ----
smoothLight = 1; atlasRows = 16; tileDU = 1 / 32 - 0.0004; tileDV = 1 / atlasRows - 0.0004;
bkFlags = McNewList(16); DsListSet(bkFlags, 1, 2);
bkShape = McNewList(16); bkTint = McNewList(16); bkLight = McNewList(16);
bkTT = McNewList(16); DsListSet(bkTT, 1, 33); bkTB = McNewList(16); DsListSet(bkTB, 1, 34);
bkTS = McNewList(16); DsListSet(bkTS, 1, 35);
bkTF = McNewList(16); DsListSet(bkTF, 1, -1); bkTO = McNewList(16); DsListSet(bkTO, 1, -1);
hgt = DsGridCreate(256, 256); DsGridSetRegion(hgt, 0, 0, 255, 255, 49);
extLoG = DsGridCreate(256, 256); extHiG = DsGridCreate(256, 256);
DsGridSetRegion(extLoG, 0, 0, 255, 255, 999); DsGridSetRegion(extHiG, 0, 0, 255, 255, -1);
cavLoG = DsGridCreate(256, 256); cavHiG = DsGridCreate(256, 256);
DsGridSetRegion(cavLoG, 0, 0, 255, 255, 9); DsGridSetRegion(cavHiG, 0, 0, 255, 255, 36);
bio = DsGridCreate(256, 256);
benchMesh = MeshCreate(); benchInst = DsListCreate();

// The inner 14 x 14 columns of chunk (0, 0) (the cave and its walls), a row per call as the project meshes
// a group. Returns the faces made.
function BenchMeshRow(lz) { for (var lx = 1; lx <= 14; lx = lx + 1) { McBuildColumn(0, 0, 0, lz, lx, benchMesh, benchInst); } return 0; }
function BenchMeshChunk() {
    MeshClear(benchMesh);
    for (var lz = 1; lz <= 14; lz = lz + 1) { BenchMeshRow(lz); }
    return MeshTriangleCount(benchMesh) / 2;
}
