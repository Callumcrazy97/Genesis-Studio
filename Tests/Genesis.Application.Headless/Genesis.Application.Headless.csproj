<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Keep a real console so Build.bat shows BEGIN/PASS lines live. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Avoid CS0436: with InternalsVisibleTo now granted to Genesis.Application.Studio (for
         the RunProject test hook), the SDK's auto-generated `ApplicationConfiguration` class
         collides across the two WinForms projects' compiled output. This project inlines the
         same bootstrap calls in Program.cs instead of relying on the generated helper. -->
    <EnableDefaultApplicationConfiguration>false</EnableDefaultApplicationConfiguration>
    <RootNamespace>Genesis.Application.Headless</RootNamespace>
    <AssemblyName>Genesis.Application.Headless</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\Untitled.jpg" Link="Untitled.jpg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Source\Genesis.Application.Studio\Assets\CommandVisualTest\**\*"
          Link="Assets\CommandVisualTest\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\Genesis.Application.Core\Genesis.Application.Core.csproj" />
    <ProjectReference Include="..\..\Source\Genesis.Application.Editors.Image\Genesis.Application.Editors.Image.csproj" />
    <ProjectReference Include="..\..\Source\Genesis.Application.Editors.Suite\Genesis.Application.Editors.Suite.csproj" />
    <ProjectReference Include="..\..\Source\Genesis.Application.Studio\Genesis.Application.Studio.csproj" />
    <ProjectReference Include="..\..\Source\Genesis.Application.Runtime\Genesis.Application.Runtime.csproj" />
  </ItemGroup>

</Project>
