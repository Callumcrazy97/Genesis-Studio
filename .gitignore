# -----------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.backup
*.cache
*.pidb
*.booproj

# AI Assistant Working Directories
.gemini/
.claude/
.codex-remote-attachments/
.validation/
AiControl/

